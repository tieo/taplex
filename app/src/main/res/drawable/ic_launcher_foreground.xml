<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark: a looking glass with a line of text read through it, the word above and what
    it means under it. One gradient runs across the whole thing, lens and handle alike, so
    it reads as a single object rather than a disc with a stick attached.

    Drawn on a 48 grid and scaled into the 72dp the system promises never to crop, since an
    icon with no background of its own is masked to whatever shape the launcher uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.35"
        android:scaleY="1.35"
        android:translateX="20.9"
        android:translateY="22.3">
        <path
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:pathData="M32.4,31.4L42,41">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="3"
                    android:startY="2"
                    android:endX="45"
                    android:endY="45">
                    <item android:offset="0" android:color="#322B6B" />
                    <item android:offset="1" android:color="#F0803C" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M20,1.5A17.5,17.5 0 1,0 20.001,1.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="3"
                    android:startY="2"
                    android:endX="45"
                    android:endY="45">
                    <item android:offset="0" android:color="#322B6B" />
                    <item android:offset="1" android:color="#F0803C" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FFF7E8"
            android:pathData="M12.7,11.5 H27.3 A3.2,3.2 0 0,1 27.3,17.9 H12.7 A3.2,3.2 0 0,1 12.7,11.5 Z" />
        <path
            android:fillColor="#FFC98A"
            android:pathData="M12.7,21 H19.3 A3.2,3.2 0 0,1 19.3,27.4 H12.7 A3.2,3.2 0 0,1 12.7,21 Z" />
    </group>
</vector>
