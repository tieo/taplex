<!-- The say field: a surface of its own inside the panel, so the thing being typed into
     reads as a box rather than as a line ruled under some text. Matched to the card the
     answer arrives in, one shade lighter than the panel it sits on. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF141C26" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#2A3442" />
</shape>
