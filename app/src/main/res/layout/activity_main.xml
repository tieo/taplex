<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dictionaries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translate from"
            android:paddingTop="8dp" />

        <Spinner
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translate to"
            android:paddingTop="16dp" />

        <Spinner
            android:id="@+id/target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/wordLookup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Set up word lookup" />

        <Button
            android:id="@+id/overlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow drawing over other apps" />

        <Button
            android:id="@+id/arm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Arm WordTap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:textSize="14sp"
            android:text="Word lookup reads the words straight from the apps on screen, so nothing is recorded and no capture runs in the background. Turn it on under Set up word lookup, then press the accessibility button whenever you want a word: WordTap puts a box around every word, and a tap on one shows its translation. Screens that draw their text as a picture, like games, fall back to a single screenshot taken at that moment.\n\nArming instead starts the older path: a screen capture session stays open while a bubble sits on top of every app, which is what the ongoing recording notification is. Use it only where word lookup cannot be turned on.\n\nRecognition and translation both run on the device. The first use of a language pair downloads a model of about 30 MB." />
    </LinearLayout>
</ScrollView>
